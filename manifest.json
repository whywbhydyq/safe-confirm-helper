{
  "manifest_version": 3,
  "name": "Safe Confirm Helper",
  "version": "2.0.0",
  "description": "ChatGPT 长任务自验证监督插件：通过 SCH_FINAL 停机门控减少提前停止、漏做和假完成。",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Safe Confirm Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/text.js",
        "src/content/dom-utils.js",
        "src/content/settings-store.js",
        "src/content/button-scanner.js",
        "src/content/composer.js",
        "src/content/assistant-detector.js",
        "src/content/long-task-detector.js",
        "src/content/supervision-prompts.js",
        "src/content/final-parser.js",
        "src/content/task-controller.js",
        "src/content/automation-loop.js",
        "src/content/public-state.js",
        "src/content/cleanup.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
